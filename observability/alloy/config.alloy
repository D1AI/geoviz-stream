otelcol.receiver.faro "frontend" {
  endpoint = "0.0.0.0:12347"
  cors_allowed_origins = ["*"]
  cors_allowed_methods = ["POST", "OPTIONS"]
  cors_allowed_headers = ["content-type", "x-faro-session-id"]
  output {
    logs   = [otelcol.processor.batch.main.input]
    traces = [otelcol.processor.batch.main.input]
  }
}

otelcol.receiver.otlp "otlp" {
  http { endpoint = "0.0.0.0:4318" }
  grpc { endpoint = "0.0.0.0:4317" }
  output {
    metrics = [otelcol.processor.batch.main.input]
    logs    = [otelcol.processor.batch.main.input]
    traces  = [otelcol.processor.batch.main.input]
  }
}

otelcol.processor.batch "main" {
  timeout             = "2s"
  send_batch_max_size = 8192
  output {
    metrics = [otelcol.processor.transform.res.input]
    logs    = [otelcol.processor.transform.res.input]
    traces  = [otelcol.processor.transform.res.input]
  }
}

otelcol.processor.transform "res" {
  metric_statements {
    context = "resource"
    statements = [
      `set(resource.attributes["service.namespace"], "geoviz")`,
      `set(resource.attributes["deployment.environment"], "local")`,
    ]
  }
  log_statements {
    context = "resource"
    statements = [
      `set(resource.attributes["service.namespace"], "geoviz")`,
      `set(resource.attributes["deployment.environment"], "local")`,
    ]
  }
  trace_statements {
    context = "resource"
    statements = [
      `set(resource.attributes["service.namespace"], "geoviz")`,
      `set(resource.attributes["deployment.environment"], "local")`,
    ]
  }
  output {
    logs   = [otelcol.exporter.otlphttp.to_loki.input]
    traces = [otelcol.exporter.otlphttp.to_tempo.input]
  }
}

otelcol.exporter.otlphttp "to_loki" {
  client {
    endpoint = "http://loki:3100/otlp"
    tls { insecure = true }
  }
}

otelcol.exporter.otlphttp "to_tempo" {
  client {
    endpoint = "http://tempo:4318"
    tls { insecure = true }
  }
}
